# Copy to .env.providers (ignored by Git). Fill locally; never commit secrets.
GOOGLE_CLOUD_PROJECT=your-bigquery-execution-project
LLM_PROVIDER=deepinfra
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
DEEPINFRA_API_KEY=replace-with-your-deepinfra-key
# Use a Gemini model ID enabled for your provider account.
DEEPINFRA_MODEL=google/gemini-3.7-flash
# Optional separate report reviewer model; blank uses the generation model.
DEEPINFRA_REVIEW_MODEL=
# No paid embedding calls on initial setup.
EMBEDDING_PROVIDER=none
BRAND_ACCESS_JSON='{"alice":{"role":"manager","brands":["Seven7","Calvin Klein"]},"bob":{"role":"manager","brands":["Diesel"]},"ceo":{"role":"ceo"}}'
MINIMUM_COHORT_SIZE=5
CHURN_WINDOW_DAYS=90
