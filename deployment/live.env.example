# Copy to .env.providers (ignored by Git). Never commit populated credentials.
GOOGLE_CLOUD_PROJECT=your-bigquery-execution-project
LLM_PROVIDER=gemini
# Gemini-protocol endpoint; use your provider's URL if different.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_KEY=replace-with-your-api-key
GEMINI_MODEL=replace-with-your-enabled-model-id
# Start without billed embedding indexing; lexical retrieval remains available.
EMBEDDING_PROVIDER=none
# Static demo brand permissions; replace the brands as needed. CEO sees all brands.
BRAND_ACCESS_JSON='{"alice":{"role":"manager","brands":["Seven7","Calvin Klein"]},"bob":{"role":"manager","brands":["Diesel"]},"ceo":{"role":"ceo"}}'
MINIMUM_COHORT_SIZE=5
CHURN_WINDOW_DAYS=90

# Keep off unless observability is needed; Langfuse requires its own stack.
LANGFUSE_ENABLED=false

# Alternative: set LLM_PROVIDER=openai_compatible and fill all three fields below.
# Use the provider's API base URL (usually https://your-provider/v1), not a chat-page URL.
# This path uses the gateway key/model; GEMINI_API_KEY/GEMINI_BASE_URL are unused.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
