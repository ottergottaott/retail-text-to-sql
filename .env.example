# Local fixture configuration. Copy to .env and replace secret placeholders.
RETAIL_MODE=fixture
DATABASE_URL=sqlite:///./retail.db
API_TOKENS_JSON={"alice-local-token":"alice","bob-local-token":"bob","ceo-local-token":"ceo"}
BRAND_ACCESS_JSON={"alice":{"role":"manager","brands":["North","South"]},"bob":{"role":"manager","brands":["West"]},"ceo":{"role":"ceo"}}
MINIMUM_COHORT_SIZE=5
CHURN_WINDOW_DAYS=90
LABEL_SECRET=replace-with-a-random-value
ADAPTER_SECRET=replace-with-a-random-value
WEBUI_USERS_JSON={}
POSTGRES_PASSWORD=replace-with-a-random-url-safe-value
WEBUI_SECRET_KEY=replace-with-a-random-value
# Live mode additionally needs these and Google application-default credentials.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_KEY=
GEMINI_MODEL=
GOOGLE_CLOUD_PROJECT=
EMBEDDING_MODEL=gemini-embedding-001
# Alternative: route Gemini and Qwen embeddings through DeepInfra.
# Keep gemini providers for direct Google testing by assignment reviewers.
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=google/gemini-3.7-flash
# Optional stronger final grounding reviewer; empty uses the planning model.
DEEPINFRA_REVIEW_MODEL=
DEEPINFRA_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# Healthy hybrid retrieval: lexical candidates must have semantic support.
RETRIEVAL_MIN_SIMILARITY=0.65
RETRIEVAL_LEXICAL_MIN_SIMILARITY=0.60
# On the host, a path to your existing Google credentials:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-credentials.json
# For containers use a read-only credential mount; see docs/setup.md.

# Keep off unless observability is needed; Langfuse requires its own stack.
LANGFUSE_ENABLED=false

# Optional OpenAI-compatible gateway (for example WikiVibe). Set LLM_PROVIDER=openai_compatible.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Automatic feedback/tone checks run in the API process with the configured model.
AUTOMATION_ENABLED=true
AUTOMATION_POLL_SECONDS=5
